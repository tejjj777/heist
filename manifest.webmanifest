{
  "name": "HEIST",
  "short_name": "HEIST",
  "description": "Catch the leaks. A money planner for students: see what you can spend today, split bills and save for goals.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#F6F3FF",
  "theme_color": "#F6F3FF",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add an expense",
      "short_name": "Add expense",
      "url": "./index.html#do/add-expense",
      "icons": [
        {
          "src": "assets/sc-add.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Scan a receipt",
      "short_name": "Scan receipt",
      "url": "./index.html#do/scan-receipt",
      "icons": [
        {
          "src": "assets/sc-receipt.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Paste a bank message",
      "short_name": "Bank message",
      "url": "./index.html#do/import-sms",
      "icons": [
        {
          "src": "assets/sc-message.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bill calendar",
      "short_name": "Calendar",
      "url": "./index.html#dashboard/calendar",
      "icons": [
        {
          "src": "assets/sc-calendar.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shots",
          "accept": [
            "image/*",
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      ]
    }
  }
}